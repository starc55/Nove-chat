generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum OperatorStatus {
  ONLINE
  AWAY
  OFFLINE
}

enum ConversationStatus {
  OPEN
  WAITING
  ASSIGNED
  CLOSED
}

enum MessageSenderType {
  CUSTOMER
  OPERATOR
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  NEW
  PROCESSING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AdvertisementPlacement {
  HERO
  AFTER_HERO
  PRODUCTS_TOP
  PRODUCTS_BOTTOM
  FLOATING
  FOOTER
}

enum AutoReplyTrigger {
  CHAT_OPEN
  FIRST_MESSAGE
  OFFLINE
}

enum TelegramUpdateStatus {
  PROCESSING
  PROCESSED
  FAILED
}

enum TelegramDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  admin        Admin?
  operator     Operator?
  refreshTokens RefreshToken[]
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Operator {
  id            String          @id @default(cuid())
  userId        String          @unique
  displayName   String
  avatarUrl     String?
  status        OperatorStatus  @default(OFFLINE)
  lastSeenAt    DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegram      TelegramOperator?
  conversations Conversation[]
  messages      Message[]
  leads         Lead[]
  ratings       Rating[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  @@index([status])
}

model TelegramOperator {
  id             String   @id @default(cuid())
  operatorId     String   @unique
  telegramUserId String   @unique
  telegramChatId String?  @unique
  username       String?
  enabled        Boolean  @default(true)
  activeConversationId String?
  verifiedAt     DateTime?
  lastInteractionAt DateTime?
  operator       Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  deliveries     TelegramDelivery[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled, verifiedAt])
}

model Customer {
  id           String   @id @default(cuid())
  visitorId    String   @unique
  name         String?
  phone        String?
  email        String?
  telegram     String?
  conversations Conversation[]
  leads         Lead[]
  ratings       Rating[]
  reviews       Review[]
  purchaseRequests PurchaseRequest[]
  subscriptions PushSubscription[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Conversation {
  id                 String             @id @default(cuid())
  publicId           String             @unique
  customerId         String
  assignedOperatorId String?
  status             ConversationStatus @default(WAITING)
  channel            String             @default("website")
  sourcePath         String?
  startedAt          DateTime           @default(now())
  closedAt           DateTime?
  lastMessageAt      DateTime           @default(now())
  customer           Customer           @relation(fields: [customerId], references: [id])
  assignedOperator   Operator?          @relation(fields: [assignedOperatorId], references: [id])
  messages           Message[]
  leads              Lead[]
  rating             Rating?
  review             Review?
  @@index([status, lastMessageAt])
  @@index([assignedOperatorId, status])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderType     MessageSenderType
  senderId       String?
  operatorId     String?
  content        String
  type           MessageType       @default(TEXT)
  status         MessageStatus     @default(SENT)
  createdAt      DateTime          @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  operator       Operator?         @relation(fields: [operatorId], references: [id])
  telegramDeliveries TelegramDelivery[]
  @@index([conversationId, createdAt])
}

model TelegramUpdate {
  updateId    BigInt               @id
  status      TelegramUpdateStatus @default(PROCESSING)
  error       String?
  processedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, updatedAt])
}

model TelegramDelivery {
  id                 String                 @id @default(cuid())
  messageId          String
  telegramOperatorId String
  status             TelegramDeliveryStatus @default(PENDING)
  attempts           Int                    @default(0)
  nextAttemptAt      DateTime               @default(now())
  lastError          String?
  sentAt             DateTime?
  message            Message                @relation(fields: [messageId], references: [id], onDelete: Cascade)
  telegramOperator   TelegramOperator       @relation(fields: [telegramOperatorId], references: [id], onDelete: Cascade)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([messageId, telegramOperatorId])
  @@index([status, nextAttemptAt])
}

model Lead {
  id                 String     @id @default(cuid())
  customerId         String
  conversationId     String?
  name               String
  phone              String
  telegramUsername   String?
  email              String?
  message            String?
  status             LeadStatus @default(NEW)
  source             String     @default("offline_chat")
  assignedOperatorId String?
  contactedAt        DateTime?
  customer           Customer   @relation(fields: [customerId], references: [id])
  conversation       Conversation? @relation(fields: [conversationId], references: [id])
  assignedOperator   Operator?  @relation(fields: [assignedOperatorId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  @@index([status, createdAt])
}

model Product {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  shortDescription String
  longDescription  String?
  price            Decimal?       @db.Decimal(15, 2)
  oldPrice         Decimal?       @db.Decimal(15, 2)
  image            String?
  category         String?
  active           Boolean        @default(true)
  featured         Boolean        @default(false)
  sortOrder        Int            @default(0)
  images           ProductImage[]
  purchaseRequests PurchaseRequest[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  @@index([active, featured, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Advertisement {
  id          String                 @id @default(cuid())
  title       String
  description String?
  image       String?
  ctaLabel    String?
  ctaUrl      String?
  placement   AdvertisementPlacement
  startAt     DateTime?
  endAt       DateTime?
  enabled     Boolean                @default(true)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  @@index([enabled, placement, startAt, endAt])
}

model Review {
  id             String       @id @default(cuid())
  customerId     String?
  customerName   String
  customerPhone  String?
  conversationId String?      @unique
  rating         Int
  comment        String
  status         ReviewStatus @default(PENDING)
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model PurchaseRequest {
  id          String      @id @default(cuid())
  customerId  String
  productId   String
  name        String
  phone       String
  comment     String?
  status      OrderStatus @default(NEW)
  sourcePath  String?
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([productId, createdAt])
}

model Rating {
  id             String   @id @default(cuid())
  conversationId String   @unique
  operatorId     String?
  customerId     String
  rating         Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  operator       Operator? @relation(fields: [operatorId], references: [id])
  customer       Customer @relation(fields: [customerId], references: [id])
  createdAt      DateTime @default(now())
}

model PushSubscription {
  id         String   @id @default(cuid())
  customerId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  active     Boolean  @default(true)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AutoReply {
  id        String           @id @default(cuid())
  trigger   AutoReplyTrigger @unique
  text      String
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
