{
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://nove-chat.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://nove-chat.onrender.com/robots.txt"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://nove-chat.onrender.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
