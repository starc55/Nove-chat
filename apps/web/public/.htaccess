Options -MultiViews

<IfModule dir_module>
  DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^favicon\.ico$ xion-logo.svg [L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Build-time SEO pages: /catalog -> /catalog.html, /ru/catalog -> /ru/catalog.html.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.html
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/(?:admin|operator)(?:/|$)" XION_PRIVATE_ROUTE=1
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=XION_PRIVATE_ROUTE

  <FilesMatch "\.(?:css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|pdf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(?:index\.html|\.htaccess)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
